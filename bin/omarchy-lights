#!/bin/bash
set -u

ROOT=$(dirname "$(dirname "$(readlink -f "$0")")")
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-lights"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-lights"
PALETTE="$STATE_DIR/palette.json"
LOG="$STATE_DIR/lights.log"
SERVICE=omarchy-lights.service

mkdir -p "$STATE_DIR" "$CONFIG_DIR"

enabled() {
  python3 -c "import json,sys;print(str(json.load(open(sys.argv[1])).get(sys.argv[2],{}).get('enabled',True)).lower())" "$CONFIG_DIR/config.json" "$1" 2>/dev/null || echo true
}

daemon_running() {
  systemctl --user is-active --quiet "$SERVICE"
}

current_accent() {
  omarchy-theme-color accent 2>/dev/null
}

theme_colors() {
  local file="$HOME/.local/state/omarchy/current/theme/lights.rgb" line
  if [[ -f $file ]]; then
    while read -r line; do
      line=${line%%#*}; [[ -n $line ]] || continue
      line=${line//[[:space:]]/}
      [[ $line =~ ^[0-9a-fA-F]{6}$ ]] && echo "$line"
    done < <(sed 's/^\s*#//' "$file")
  fi
}

normalize_colors() {
  local c out=()
  for c in "$@"; do
    c=${c#\#}; c=${c,,}
    [[ $c =~ ^[0-9a-f]{6}$ ]] || { echo "invalid color: $c" >&2; return 1; }
    out+=("$c")
  done
  echo "${out[*]}"
}

cmd_sync() {
  local colors
  if (( $# > 0 )); then
    colors=$(normalize_colors "$@") || exit 1
  else
    mapfile -t theme < <(theme_colors)
    if (( ${#theme[@]} > 0 )); then
      colors=$(normalize_colors "${theme[@]}")
    else
      colors=$(normalize_colors "$(current_accent)") || { echo "could not resolve accent color"; exit 1; }
    fi
  fi
  local now last_colors last_time
  now=$(date +%s)
  { read -r last_colors; read -r last_time; } 2>/dev/null <"$STATE_DIR/last-sync" || true
  if [[ ${last_colors:-} == "$colors" && $((now - ${last_time:-0})) -lt 15 ]]; then
    echo "$(date +%T) sync [$colors] skipped (already applied $((now - last_time))s ago)" >>"$LOG"
    return 0
  fi
  printf '%s\n%s\n' "$colors" "$now" >"$STATE_DIR/last-sync"
  # shellcheck disable=SC2086
  python3 "$ROOT/lib/palette.py" $colors >"$PALETTE.tmp" && mv "$PALETTE.tmp" "$PALETTE"
  echo "$(date +%T) sync [$colors] $(python3 -c "import json,sys;print(' '.join(json.load(open(sys.argv[1]))['shades']))" "$PALETTE")" >>"$LOG"

  if [[ $(enabled desk) == true ]]; then
    (python3 "$ROOT/backends/desk.py" apply >>"$LOG" 2>&1 &)
  fi
  if [[ $(enabled keyboard) == true ]]; then
    (python3 "$ROOT/backends/keyboard.py" apply >>"$LOG" 2>&1 &)
  fi
  if ! daemon_running; then
    [[ $(enabled fans) == true ]] && ("$ROOT/backends/fans.sh" >>"$LOG" 2>&1 &)
    [[ $(enabled govee) == true ]] && (python3 "$ROOT/backends/govee.py" set "#${colors%% *}" >>"$LOG" 2>&1 &)
  fi
}

cmd_toggle() {
  local id=${1:-} want=${2:-}
  [[ -n $id ]] || { echo "usage: omarchy-lights toggle <id> [on|off]"; exit 1; }
  python3 "$ROOT/lib/toggle.py" "$id" "$want"
}

cmd_hw() {
  [[ -f $STATE_DIR/status.json ]] || { echo "no status yet (is the daemon running?)"; return 1; }
  python3 -c "
import json,sys
s = json.load(open(sys.argv[1]))
for d in s['devices']:
    print('%-3s %-14s %-14s %s' % ('[x]' if d['enabled'] else '[ ]', d['id'], d['name'], d['detail'] or ''))
" "$STATE_DIR/status.json"
}

cmd_status() {
  echo "theme:   $(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null) (accent $(current_accent))"
  echo "palette: $([[ -f $PALETTE ]] && python3 -c "import json,sys;print(' '.join(json.load(open(sys.argv[1]))['shades']))" "$PALETTE" || echo none)"
  echo "hook:    $([[ -f $HOME/.config/omarchy/hooks/theme-set.d/omarchy-lights ]] && echo installed || echo missing)"
  echo "daemon:  $(systemctl --user is-active "$SERVICE" 2>/dev/null) (fans + govee + mic animation)"
  echo "openrgb: $(command -v openrgb >/dev/null && echo installed || echo missing)"
  echo "desk:    $(python3 -c "import json,sys;c=json.load(open(sys.argv[1]))['desk'];print(c['host'] or 'unknown host', 'paired' if c['token'] else 'NOT paired')" "$CONFIG_DIR/config.json" 2>/dev/null || echo unconfigured)"
  echo "govee:   $(python3 "$ROOT/backends/govee.py" scan 2>/dev/null | python3 -c "import json,sys;d=json.load(sys.stdin);print(', '.join(f\"{v['sku']}@{v['ip']}\" for v in d.values()) or 'none found on LAN')")"
  echo "log:     $LOG  (daemon: journalctl --user -u $SERVICE)"
}

case "${1:-}" in
  sync) shift; cmd_sync "$@" ;;
  toggle) shift; cmd_toggle "$@" ;;
  hw) cmd_hw ;;
  status) cmd_status ;;
  daemon) exec python3 "$ROOT/backends/daemon.py" ;;
  restart) systemctl --user restart "$SERVICE" && echo restarted ;;
  pair-desk) python3 "$ROOT/backends/desk.py" pair ;;
  desk) shift; python3 "$ROOT/backends/desk.py" "${1:-apply}" ;;
  fans) shift; python3 "$ROOT/backends/fans.py" "${1:-info}" ;;
  keyboard) shift; python3 "$ROOT/backends/keyboard.py" "${1:-apply}" ;;
  govee) shift; python3 "$ROOT/backends/govee.py" "$@" ;;
  palette) shift; if (( $# > 0 )); then python3 "$ROOT/lib/palette.py" "$@"; else mapfile -t t < <(theme_colors); python3 "$ROOT/lib/palette.py" "${t[@]:-$(current_accent)}"; fi ;;
  log) tail -n "${2:-30}" "$LOG" ;;
  *)
    cat <<USAGE
usage: omarchy-lights <command>
  sync [hex ...]     apply the theme's lights.rgb colors (or accent, or the given colors)
  hw                 list the hardware and what is syncing
  toggle <id> [on|off]
                     turn syncing on or off for one device (ids from 'hw')
  status             what is installed / paired / running
  restart            restart the animation daemon (after editing config.json)
  pair-desk          pair with the Secretlab MAGRGB (Nanoleaf API)
  desk [apply|info]  desk backend
  fans [info|run]    fans backend (openrgb direct mode)
  keyboard [apply|info]
                     keyboard backend (reactive effect in the theme accent)
  govee scan|set <#hex>|release
  daemon             run the fans + govee animation loop in the foreground
  palette [hex ...]  print the generated palette
  log [n]            tail the log
USAGE
    ;;
esac
